<?xml version="1.0"?>
  <ruleset name="API CV (IDE)">
      <description>phpcs ruleset for IDE live inspection — aligned with Laravel Pint</description>

      <arg name="colors"/>
      <arg name="extensions" value="php"/>

      <rule ref="PSR12">
          <!-- Pint allows long lines -->
          <exclude name="Generic.Files.LineLength"/>

          <!-- Pint owns PHPDoc style (two spaces after @param, etc.) -->
          <exclude name="Squiz.Commenting.FunctionComment"/>
          <exclude name="Squiz.Commenting.FunctionCommentThrowTag"/>
          <exclude name="Squiz.Commenting.VariableComment"/>

          <!-- Pint controls operator/concat spacing -->
          <exclude name="PSR12.Operators.OperatorSpacing"/>
          <exclude name="PSR12.Traits.UseDeclaration.MultipleImport"/>
          <exclude name="PSR12.Classes.ClassInstantiation.MissingParentheses"/>

          <!-- Pint controls multi-line function call / declaration wrapping -->
          <exclude name="PEAR.Functions.FunctionCallSignature"/>
          <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
          <exclude name="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore"/>
          <exclude name="Squiz.WhiteSpace.SuperfluousWhitespace.EndLine"/>
      </rule>
  </ruleset>